{
  "name": "ballast-sdk",
  "version": "0.1.0-preview",
  "description": "Preview SDK for the Ballast launchpad on Robinhood Chain (4663). Reads, quotes, writes, and typed event decoders.",
  "type": "module",
  "license": "MIT",
  "author": "Ballast",
  "homepage": "https://ballasted.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ballasted/ballast.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/ballasted/ballast/issues"
  },
  "keywords": [
    "ballast",
    "robinhood-chain",
    "uniswap-v4",
    "viem",
    "launchpad",
    "sdk"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:abis": "node scripts/gen-abis.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fork": "vitest run --config vitest.fork.config.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "viem": "^2.21.0",
    "vitest": "^2.1.0"
  }
}

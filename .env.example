# BALLAST — .env.example
#
# Copy to .env and fill. Never commit .env.
# Everything here is the human's job. Claude Code should add new variables to this
# file with a comment, never invent values.

# ─────────────────────────────────────────────────────────────
# CHAIN — Robinhood Chain
# ─────────────────────────────────────────────────────────────

# Testnet first. Do not touch mainnet until tests pass and a review is done.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_TESTNET_CHAIN_ID=46630

# Public mainnet RPC is rate-limited — get a dedicated endpoint before launch.
# Alchemy is Robinhood's recommended provider; QuickNode and dRPC also support the chain.
RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_MAINNET_CHAIN_ID=4663

# Paid provider endpoint (leave blank until you have one).
# Alchemy: create an app on Robinhood Chain → copy the HTTPS URL.
RH_RPC_URL_PAID=

# Block explorer / verification
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com

# ─────────────────────────────────────────────────────────────
# DEPLOYMENT KEYS
# ─────────────────────────────────────────────────────────────

# Deployer private key. Use a FRESH wallet that holds only what you need for gas.
# Never reuse a wallet that holds real funds. Never commit this.
# Testnet ETH: faucet.testnet.chain.robinhood.com
DEPLOYER_PRIVATE_KEY=

# Address that will own the factory and the asset allowlist registry.
# Use a multisig for mainnet. A hot EOA owning the allowlist is a single point of failure.
PROTOCOL_OWNER_ADDRESS=

# ── SESSION 0 PROBE (run this FIRST) ──────────────────────────
# Answers the existential question: can a smart contract receive, hold, and
# transfer out a Robinhood Stock Token? See contracts/script/ProbeStockTokenCustody.s.sol
# DEPLOYER_PRIVATE_KEY above must be a funded testnet EOA that ALREADY HOLDS the token.
# Get a canonical testnet Stock Token address from the on-chain asset registry
# (docs.robinhood.com/chain/contracts) — do NOT copy an address from a doc/blog.
PROBE_STOCK_TOKEN=
# Raw amount to move PER PATH, 18 decimals. The probe moves it twice (push + pull),
# so the EOA must hold >= 2×PROBE_AMOUNT. e.g. 1000000000000000 = 0.001 token.
PROBE_AMOUNT=
# Optional: Chainlink feed proxy for the token. If set, the probe prints
# latestRoundData (price, decimals, updatedAt, age). Leave blank to skip.
PROBE_FEED=

# Where platform fees accumulate.
PROTOCOL_VAULT_ADDRESS=

# ─────────────────────────────────────────────────────────────
# CONTRACT ADDRESSES — fill after deployment
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_LENS_ADDRESS=
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_V4_HOOK_ADDRESS=
# FeeConfig — the create flow reads the live fee split (creator/platform/referrer)
# from here instead of hardcoding 50/35/15, since the owner can retune it. Unset =
# the fee split shows a muted placeholder rather than a possibly-wrong number.
NEXT_PUBLIC_FEE_CONFIG_ADDRESS=

# ─────────────────────────────────────────────────────────────
# EXTERNAL CONTRACTS — verify each against primary sources before use
# See docs/robinhood-chain-research.md
# ─────────────────────────────────────────────────────────────

# WETH (aeWETH proxy) — from docs.robinhood.com/chain/contracts
NEXT_PUBLIC_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# Canonical, same across chains
NEXT_PUBLIC_MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
NEXT_PUBLIC_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# ⚠️ Uniswap v4 infrastructure. VERIFY THESE INDEPENDENTLY.
# The UniversalRouter on this chain is a MODIFIED FORK with an extra minHopPriceX36
# field — stock Uniswap SDK calldata reverts. Look-alike routers exist on this chain.
# Confirm on Blockscout before routing any value through the router.
NEXT_PUBLIC_POOL_MANAGER_ADDRESS=
# UniversalRouter — verified 2026-07-23 on Blockscout as the fork with minHopPriceX36
# (docs/robinhood-chain-research.md §4). Two look-alikes exist; re-verify before use.
NEXT_PUBLIC_UNIVERSAL_ROUTER_ADDRESS=0x8876789976dEcBfCbBbe364623C63652db8C0904
NEXT_PUBLIC_V4_QUOTER_ADDRESS=
NEXT_PUBLIC_STATE_VIEW_ADDRESS=

# ETH/USD Chainlink STANDARD proxy (NOT the SVR proxy) — used by the UI to price
# token/WETH market prices and the backing preview in dollars. Same feed the
# factory uses on-chain. From docs/robinhood-chain-research.md.
NEXT_PUBLIC_ETH_USD_FEED_ADDRESS=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9

# Chainlink L2 Sequencer Uptime Feed on Robinhood Chain.
# ⚠️ Verified 2026-07: Chainlink publishes NONE for chain 4663. Leave blank —
# BackingLens treats an unset feed as sequencerStatus=Unknown and still values.
SEQUENCER_UPTIME_FEED_ADDRESS=

# ─────────────────────────────────────────────────────────────
# ASSET ALLOWLIST — read by script/SetAssets.s.sol (setAsset per asset)
# ─────────────────────────────────────────────────────────────
# For EACH asset, TWO addresses, BOTH human-verified against their primary source:
#
#   TOKEN_<TICKER>  the canonical Robinhood Stock Token address. Copy it from the
#                   on-chain asset registry at docs.robinhood.com/chain/contracts.
#                   A matching ticker with a DIFFERENT address is an impostor — never
#                   trust a blog/Discord address (research §2, CLAUDE.md rule 14).
#   FEED_<TICKER>   the Chainlink STANDARD proxy (proxyAddress) from the feeds page:
#                   docs.chain.link/data-feeds/price-feeds/addresses?network=robinhood
#                   NOT the SVR proxy (secondaryProxyAddress). They sit on the same
#                   row and can look identical on-chain yet diverge later, so no
#                   runtime check catches a swap — get it right here (rule 15).
#
# Leave a pair BLANK for any candidate that has NO official Chainlink feed on 4663
# (only ~35 of ~95 stock tokens do — rule 17). SetAssets skips + lists those; a
# token without a feed cannot be ballast. Run `DRY_RUN=true forge script … SetAssets`
# first: it reads decimals(), checks the feed description names the ticker, and prints
# the implied USD floor of each minDeposit — before anything is written on-chain.
#
# ASSET_REGISTRY is the deployed AssetRegistry (mainnet address is in web/.env.local
# and the deploy notes; it is not committed). SetAssets calls it as the owner.
ASSET_REGISTRY=

# SGOV is already allowlisted; addresses shown are the VERIFIED ones (STANDARD feed).
TOKEN_SGOV=
FEED_SGOV=0xa0DF4ee0fFf975306345875E3548Fcc519577A11

# High-liquidity single stocks — fill only those with a verified feed on 4663.
TOKEN_NVDA=
FEED_NVDA=
TOKEN_TSLA=
FEED_TSLA=
TOKEN_GOOGL=
FEED_GOOGL=
TOKEN_AAPL=
FEED_AAPL=
TOKEN_MSFT=
FEED_MSFT=
TOKEN_AMZN=
FEED_AMZN=
TOKEN_META=
FEED_META=

# Broad ETFs.
TOKEN_SPY=
FEED_SPY=
TOKEN_QQQ=
FEED_QQQ=

# ─────────────────────────────────────────────────────────────
# IPFS / PINATA (project logo + metadata pinning)
# ─────────────────────────────────────────────────────────────
# Pinata JWT — SERVER-SIDE ONLY. Used by the /api/pin route to pin the project
# logo (resized to 512x512 client-side) and the metadata JSON. The resulting
# ipfs://CID is stored on-chain as the token's metadataURI.
# ⚠️ NEVER prefix this NEXT_PUBLIC_ — that would ship your Pinata key to every
# browser. Get it at app.pinata.cloud → API Keys → New Key (needs pinFileToIPFS
# + pinJSONToIPFS scopes). Copy the JWT (not the API key/secret).
PINATA_JWT=

# Public IPFS gateway for READING pinned content in the browser (safe to expose).
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── FORGE DEPLOY SCRIPTS (bare names, read by DeployMainnet/DeployHook) ──
# v4 PoolManager — verified on Blockscout (docs/robinhood-chain-research.md §4).
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
# WETH (aeWETH). The factory mines each project token to sort BELOW this address.
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Chainlink ETH/USD STANDARD proxy (NOT the SVR 0x5058...). Converts USD backing
# to the pool's WETH/token P0 at graduation. Verify on the Chainlink feeds page.
ETH_USD_FEED=0x78F3556b67E17Df817D51Ef5a990cDaF09E8d3A9

# ─────────────────────────────────────────────────────────────
# X (TWITTER) VERIFICATION
# ─────────────────────────────────────────────────────────────
# No credentials needed. X account verification uses the FREE oEmbed endpoint
# (publish.twitter.com/oembed) — a project pastes a tweet URL, the server fetches
# its oEmbed JSON and checks it contains the derived verification code. The paid
# OAuth 2.0 route was dropped, so X_OAUTH_CLIENT_ID / X_OAUTH_CLIENT_SECRET /
# X_OAUTH_REDIRECT_URI / SESSION_SECRET are intentionally gone — do not re-add them.

# ─────────────────────────────────────────────────────────────
# WEBSITE VERIFICATION
# Projects prove domain control via a meta tag or /.well-known/ballast.txt
# ─────────────────────────────────────────────────────────────

# Salt used to derive each project's verification code. Generate: openssl rand -hex 32
# Changing this invalidates every pending verification.
WEBSITE_VERIFY_SALT=

# ─────────────────────────────────────────────────────────────
# DATABASE — stores link verifications, X account IDs, disclosure acknowledgements
# Local: docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres
# Hosted: Neon, Supabase, or Railway all work
# ─────────────────────────────────────────────────────────────

DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# INDEXER (Ponder)
# ─────────────────────────────────────────────────────────────

PONDER_RPC_URL_4663=
# Lower bound for log scans. Set to the block your factory was deployed at.
PONDER_START_BLOCK=

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# The app targets Robinhood Chain (4663) ONLY. There is no network toggle: the
# chain is hardcoded in web/lib/chain.ts so a connected wallet can never mismatch
# an env-driven target (that mismatch was the original launch failure — the app
# defaulted to testnet 46630 while wallets were on mainnet 4663).

# Dedicated RPC upstream (Alchemy) for the SERVER-SIDE /api/rpc proxy. NOT
# NEXT_PUBLIC_ — the browser talks to /api/rpc, never to this URL, so the key
# never ships to the client. Leave blank to proxy the public Robinhood RPC.
# NOTE: this belongs in web/.env.local (Next.js reads env from the web/ dir), and
# on Vercel it is a server-only variable. See the deployment notes.
RPC_UPSTREAM_URL=

# reown (WalletConnect v2) project id — powers the multi-wallet picker in /app.
# Free at cloud.reown.com → create a project → copy the Project ID. Without it the
# wallet modal falls back to injected-only discovery. Public by design.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Ponder indexer HTTP endpoint the app reads for volume/holders/trades/charts.
# The indexer runs off-Vercel (see notes); this is the URL of that service.
# Public (read-only GraphQL/HTTP). Blank = indexer-sourced figures show as delayed.
NEXT_PUBLIC_INDEXER_URL=
